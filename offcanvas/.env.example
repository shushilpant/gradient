# OffCanvas Environment Variables
# Copy to .env and configure for local sandbox development

# Canvas LMS Sandbox Configuration
CANVAS_BASE_URL=https://canvas.instructure.com
CANVAS_TOKEN=your_canvas_sandbox_api_token_here
CANVAS_COURSE_ID=99001

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# Optional local model window. Export before starting the backend, for example:
# OFFCANVAS_CONTEXT_TOKENS=32768 make assistant-start
# Default: 262144, capped at each selected model’s advertised native window.
OFFCANVAS_CONTEXT_TOKENS=262144

