{
  "manifest_version": 3,
  "name": "Gradient for Canvas",
  "version": "0.7.0",
  "description": "Plan coursework, test grade scenarios, study course materials, and keep track of Canvas deadlines.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.usm.edu/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "GRADIENT",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "32": "extension/icons/icon32.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "extension/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.usm.edu/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8086/*",
        "http://localhost:8086/*"
      ],
      "js": [
        "extension/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "32": "extension/icons/icon32.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
