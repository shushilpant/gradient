{
  "name": "gradient",
  "version": "0.1.0",
  "description": "GRADIENT: Canvas LMS Grade Model, Effort Optimiser, and Grounded Study Companion",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:grades": "vitest run tests/gradeModel.test.ts tests/gradeProperties.test.ts",
    "test:optimiser": "vitest run tests/optimiser.test.ts",
    "test:optimizer": "vitest run tests/optimiser.test.ts",
    "test:ui": "vitest run tests/panelUI.test.ts tests/workspaceBrowser.test.ts tests/liveBrowser.test.ts tests/demoReplay.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node --import tsx scripts/build.ts"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "preact": "^11.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "0.0.280",
    "@types/katex": "^0.16.8",
    "@types/node": "22.8.7",
    "fast-check": "^3.23.1",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
